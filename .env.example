# Copy to .env on your own computer only. Never upload .env.
# The Hardhat config reads it with Node's built-in loadEnvFile; no dotenv dependency.
# No event, title, date, category, quota or ticket identifier is needed for deployment.
# EXPECTED_ADMIN is the only prefilled operator value. Configure other values privately when needed.
MAINNET_RPC_URL=
ETHERSCAN_API_KEY=
# Separate READ-ONLY upstream for local fork tests. Pin a finalized block.
MAINNET_FORK_RPC_URL=
MAINNET_FORK_BLOCK=
# Operator-supplied expected initial holder; must agree with live canonical ENS before deployment.
EXPECTED_ADMIN=0xa9eD0539c2fbc5C6BC15a2E168bd9BCd07c01201
MEMBER_LABELS=
# Treat the separate disposable DEPLOYER as compromised. It must differ from the root administrator.
# Never grant it ENS approvals, parent-name control or Safe roles. Never export the root key.
# Also required for inspection when recovering without the reviewed deployment plan.
DEPLOYER_ADDRESS=
# Your explicit maximum deployment cost in ETH; blank blocks preparation.
DEPLOY_MAX_COST_ETH=
DEPLOYER_KEYSTORE=
# Enter this locally for one execution only; prefer shell environment, not this file.
DEPLOYER_KEYSTORE_PASSWORD=
# Set AFTER an authorized deployment; no fictitious address is prefilled.
REGISTRY_ADDRESS=
# Only if no retained broadcast checkpoint: the independently reviewed creation transaction hash.
DEPLOYMENT_TRANSACTION_HASH=
# Only for inspection without an approved local deployment plan: independently reviewed code hashes.
# Never derive these expected hashes from a contract or transaction supplied by the untrusted deployer.
EXPECTED_CREATION_HASH=
EXPECTED_RUNTIME_HASH=
