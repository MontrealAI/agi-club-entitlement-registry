{
  "name": "agi-club-entitlement-registry",
  "version": "2.4.0-rc.2",
  "private": true,
  "type": "module",
  "description": "ENS-rooted AGI Club benefits. Static-only optional private entitlement requests; no contact storage or email relay.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MontrealAI/agi-club-entitlement-registry.git"
  },
  "engines": {
    "node": ">=22.16.0 <23",
    "npm": ">=10 <11"
  },
  "dependencies": {
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-verify": "3.1.0",
    "axe-core": "4.13.0",
    "hardhat": "3.16.0",
    "solc": "0.8.37"
  },
  "overrides": {
    "tmp": "0.2.7"
  },
  "scripts": {
    "bootstrap:lock": "node scripts/bootstrap-lock.mjs",
    "check:lock": "node scripts/check-lock.mjs",
    "check:repo": "node scripts/check-repository.mjs",
    "compile": "hardhat build --build-profile production && node scripts/check-build.mjs && node scripts/export-etherscan.mjs",
    "export:etherscan": "npm run compile",
    "build:site": "node scripts/package.mjs",
    "test:offline": "node --test test/protocol.test.mjs test/privacy.test.mjs test/assets.test.mjs test/repository.test.mjs test/admin.test.mjs test/wallet-session.test.mjs test/receipt-input.test.mjs test/serve.test.mjs test/verify-ui.test.mjs test/deployment-ui.test.mjs test/release-gate.test.mjs test/mainnet-scripts.test.mjs test/fork-runner.test.mjs test/catalog-email.test.mjs test/language.test.mjs",
    "test:evm": "npm run test:etherscan && hardhat run scripts/evm-tests.mjs --build-profile production --network hardhat && npm run test:stateful && npm run test:scenarios",
    "test:stateful": "hardhat run scripts/stateful-tests.mjs --build-profile production --network hardhat",
    "test:fork": "node scripts/run-fork-tests.mjs",
    "test:browser": "node scripts/browser-check.mjs && node scripts/browser-privacy.mjs",
    "test": "npm run test:offline && npm run test:evm && npm run test:journey",
    "qualify": "node scripts/qualify.mjs",
    "node": "hardhat node --hostname 127.0.0.1",
    "deploy:local": "hardhat run scripts/deploy-local.mjs --build-profile production --network localhost",
    "prepare:mainnet": "hardhat run scripts/prepare-mainnet.mjs --build-profile production --network mainnet",
    "deploy:mainnet": "hardhat run scripts/deploy-mainnet.mjs --build-profile production --network mainnet",
    "inspect:mainnet": "hardhat run scripts/inspect-mainnet.mjs --build-profile production --network mainnet",
    "verify:mainnet": "hardhat verify --build-profile production --network mainnet",
    "serve": "node scripts/serve.mjs",
    "fingerprint": "node scripts/source-digest.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "upload:check": "node scripts/check-repository.mjs --upload",
    "test:journey": "hardhat run scripts/journey-tests.mjs --build-profile production --network isolatedMainnetModel",
    "privacy:check": "node --test test/privacy.test.mjs",
    "test:browser:source": "node scripts/browser-privacy.mjs --source",
    "verify:request": "node tools/verify_entitlement_request.mjs",
    "test:etherscan": "node --test test/etherscan.test.mjs",
    "launch:gate": "node scripts/benefit-launch-gate.mjs",
    "test:scenarios": "hardhat run scripts/contract-scenarios.mjs --build-profile production --network isolatedMainnetModel"
  }
}
