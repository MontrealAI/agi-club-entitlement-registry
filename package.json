{
  "name": "agi-club-entitlement-registry",
  "version": "2.3.0-rc.1",
  "private": true,
  "type": "module",
  "description": "ENS-rooted AGI Club benefits. Static-only private ticket requests; no contact storage or email relay.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MontrealAI/agi-club-entitlement-registry.git"
  },
  "engines": {
    "node": ">=22.16.0 <23",
    "npm": ">=10 <11"
  },
  "dependencies": {
    "ethers": "6.15.0"
  },
  "devDependencies": {
    "hardhat": "3.16.0",
    "@nomicfoundation/hardhat-verify": "3.1.0",
    "solc": "0.8.37"
  },
  "scripts": {
    "bootstrap:lock": "node scripts/bootstrap-lock.mjs",
    "check:lock": "node scripts/check-lock.mjs",
    "check:repo": "node scripts/check-repository.mjs",
    "compile": "hardhat build --build-profile production && node scripts/check-build.mjs",
    "build:site": "node scripts/package.mjs",
    "test:offline": "node --test test/protocol.test.mjs test/privacy.test.mjs test/assets.test.mjs test/repository.test.mjs",
    "test:evm": "hardhat run scripts/evm-tests.mjs --build-profile production --network hardhat",
    "test:fork": "hardhat run scripts/fork-tests.mjs --build-profile production --network ensFork",
    "test:browser": "node scripts/browser-check.mjs && node scripts/browser-privacy.mjs",
    "test": "npm run test:offline && npm run test:evm && npm run test:journey",
    "qualify": "node scripts/qualify.mjs",
    "node": "hardhat node --hostname 127.0.0.1",
    "deploy:local": "hardhat run scripts/deploy-local.mjs --build-profile production --network localhost",
    "prepare:mainnet": "hardhat run scripts/prepare-mainnet.mjs --build-profile production --network mainnet",
    "deploy:mainnet": "hardhat run scripts/deploy-mainnet.mjs --build-profile production --network mainnet",
    "inspect:mainnet": "hardhat run scripts/inspect-mainnet.mjs --build-profile production --network mainnet",
    "verify:mainnet": "hardhat verify --build-profile production --network mainnet",
    "serve": "node scripts/serve.mjs",
    "fingerprint": "node scripts/source-digest.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "upload:check": "node scripts/check-repository.mjs --upload",
    "test:journey": "hardhat run scripts/journey-tests.mjs --build-profile production --network isolatedMainnetModel",
    "privacy:check": "node --test test/privacy.test.mjs",
    "test:browser:source": "node scripts/browser-privacy.mjs --source",
    "verify:request": "node tools/verify_ticket_request.mjs"
  }
}
